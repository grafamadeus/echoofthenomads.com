# ---- Echo of Nomads voting API — environment ----
# Copy to .env for local dev; on the VPS this lives at /etc/echo-vote/env

NODE_ENV=production
PORT=3000
# bind to loopback only; nginx is the public entrypoint
HOST=127.0.0.1

# Postgres (local socket / localhost on the VPS)
DATABASE_URL=postgres://echovote:CHANGE_ME@127.0.0.1:5432/echovote

# Redis (loopback, password-protected)
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379

# Secret salt mixed into voter/ip hashes. Long random string. NEVER commit.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOTE_PEPPER=CHANGE_ME_64_hex_chars

# Google Identity Services OAuth 2.0 Client ID (Web).
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID -> Web
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Browser origin(s) allowed to call the API (the live site). Comma-separated.
ALLOWED_ORIGINS=https://echoofthenomads.com,https://www.echoofthenomads.com

# Bearer token for /api/admin/* (in addition to nginx basic-auth). Long random string.
ADMIN_TOKEN=CHANGE_ME

# Fallback voting window if not set in the DB (app_setting.voting_window).
# ISO 8601 with offset.
VOTE_OPENS_AT=2026-09-02T12:00:00+06:00
VOTE_CLOSES_AT=2026-09-04T23:59:00+06:00
