# /etc/systemd/system/echo-vote.service
[Unit]
Description=Echo of Nomads voting API
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/echo-vote/server
EnvironmentFile=/etc/echo-vote/env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=2
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/echo-vote
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
